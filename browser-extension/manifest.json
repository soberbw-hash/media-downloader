{
  "manifest_version": 3,
  "name": "音视频下载器 · 登录态同步",
  "short_name": "下载器同步",
  "version": "1.1.0",
  "description": "把浏览器里已登录的账号同步到本机音视频下载器。",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.xiaohongshu.com/*", "*://xiaohongshu.com/*",
    "*://*.instagram.com/*", "*://instagram.com/*",
    "*://*.douyin.com/*", "*://douyin.com/*",
    "*://*.kuaishou.com/*", "*://kuaishou.com/*",
    "*://*.bilibili.com/*", "*://bilibili.com/*",
    "*://*.weibo.com/*", "*://weibo.com/*",
    "*://*.weibo.cn/*", "*://weibo.cn/*",
    "*://*.music.163.com/*", "*://music.163.com/*",
    "*://*.qq.com/*", "*://qq.com/*",
    "*://*.suno.com/*", "*://suno.com/*",
    "*://*.suno.ai/*", "*://suno.ai/*",
    "*://*.baidu.com/*", "*://baidu.com/*",
    "*://*.quark.cn/*", "*://quark.cn/*",
    "*://*.uc.cn/*", "*://uc.cn/*",
    "*://*.xunlei.com/*", "*://xunlei.com/*",
    "*://*.123pan.com/*", "*://123pan.com/*",
    "*://*.123865.com/*", "*://123865.com/*",
    "*://*.123684.com/*", "*://123684.com/*",
    "*://*.123pan.cn/*", "*://123pan.cn/*",
    "*://*.115.com/*", "*://115.com/*",
    "*://*.115cdn.com/*", "*://115cdn.com/*",
    "*://*.139.com/*", "*://139.com/*",
    "*://*.guangyapan.com/*", "*://guangyapan.com/*",
    "*://*.guangyapan.cn/*", "*://guangyapan.cn/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "把登录态同步到音视频下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
